# Contact form delivery (option B).
# Vite reads these at BUILD time, so set them in Vercel →
# Settings → Environment Variables. A local .env file only affects local builds.

# --- Formspree (endpoint only) ---
# VITE_CONTACT_ENDPOINT=https://formspree.io/f/xxxxxxxx

# --- Web3Forms (endpoint + key) ---
# VITE_CONTACT_ENDPOINT=https://api.web3forms.com/submit
# VITE_CONTACT_KEY=your-access-key
